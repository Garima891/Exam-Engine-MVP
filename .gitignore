# Local MVP biometric database. Face and voice embeddings are protected with
# Windows DPAPI for the current Windows user; protected records require that
# user context and may become unrecoverable if the database is moved to another
# Windows account or machine. The SQLite database itself is not fully encrypted.
integration/candidate_embeddings.sqlite3
integration/candidate_embeddings.sqlite3-shm
integration/candidate_embeddings.sqlite3-wal

# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/

# Local databases and backups
*.sqlite3
*.db
integration/proctoring_event_history.jsonl

*.wav
